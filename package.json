{
  "name": "ai-compiler",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:all": "bash -lc 'node tools/kadima/daemon.mjs & npm --prefix tools/kadima run ui:dev & wait'",
