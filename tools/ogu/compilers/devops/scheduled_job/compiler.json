{
  "id": "scheduled_job",
  "title": "Scheduled Job Compiler",
  "version": "1.0.0",
  "description": "Compiles Kubernetes CronJobs and CI schedule entries. Enforces: cron expression parses, job template valid, concurrencyPolicy set, backoff/history limits valid, no undeclared secrets.",
  "tier": "devops",
  "ir": {
    "input_artifact": "dockerfile-artifact.json",
    "output_artifact": "scheduled-job-artifact.json",
    "identifier": "SCHEDULED_JOB"
  },
  "phases": [
    {
      "id": 1,
      "name": "Parse & Validate Spec",
      "gates": [
        "spec-valid"
      ]
    },
    {
      "id": 2,
      "name": "Structure Check",
      "gates": [
        "cron-expression-valid",
        "job-template-valid"
      ]
    },
    {
      "id": 3,
      "name": "Security/Policy Check",
      "gates": [
        "concurrency-policy-set",
        "limits-valid"
      ]
    },
    {
      "id": 4,
      "name": "Quality",
      "gates": [
        "no-undeclared-secrets"
      ]
    },
    {
      "id": 5,
      "name": "Attest",
      "gates": [
        "no-todos"
      ]
    },
    {
      "id": 6,
      "name": "Phase 6",
      "gates": [
        "contract-scheduled-job"
      ]
    }
  ],
  "gates": [
    {
      "id": "SJ001",
      "name": "spec-valid",
      "phase": 1
    },
    {
      "id": "SJ002",
      "name": "cron-expression-valid",
      "phase": 2
    },
    {
      "id": "SJ003",
      "name": "job-template-valid",
      "phase": 2
    },
    {
      "id": "SJ004",
      "name": "concurrency-policy-set",
      "phase": 3
    },
    {
      "id": "SJ005",
      "name": "limits-valid",
      "phase": 3
    },
    {
      "id": "SJ006",
      "name": "no-undeclared-secrets",
      "phase": 4
    },
    {
      "id": "SJ007",
      "name": "no-todos",
      "phase": 5
    },
    {
      "id": "SJ008",
      "name": "contract-scheduled-job",
      "phase": 6
    }
  ],
  "error_codes": {
    "SJ001": "scheduled-job-spec.json missing — required: name, schedule, command, image",
    "SJ002": "Cron expression is invalid or unparseable",
    "SJ003": "Job template missing required fields",
    "SJ004": "concurrencyPolicy not set — defaults to Allow which may cause job pile-up",
    "SJ005": "backoffLimit or historyLimits are not valid non-negative integers",
    "SJ006": "Job mounts or references undeclared secrets/configmaps",
    "SJ007": "TODO/FIXME found",
    "SJ008": "Scheduled job contract violation"
  }
}