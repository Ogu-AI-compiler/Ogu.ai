{
  "compiler_id": "compiler_qa-engineer",
  "role": "qa-engineer",
  "version": "1.0.0",
  "registered_at": "2026-03-08T00:00:00.000Z",
  "updated_at": "2026-03-08T00:00:00.000Z",

  "domain": {
    "category": "quality",
    "display_name": "QA Engineer",
    "min_tier": 1
  },

  "pipeline": {
    "phases": [
      "test-strategy",
      "test-case-design",
      "automation",
      "regression",
      "release-readiness"
    ],
    "consumes": ["Spec.md", "Plan.json", "implementation artifacts"],
    "produces": ["QA.md", "test files", "test report", "regression suite"]
  },

  "gates": [
    {
      "id": "qa-plan-exists",
      "description": "QA.md test strategy document must exist",
      "type": "file_exists",
      "pattern": "QA.md",
      "severity": "error"
    },
    {
      "id": "test-files-exist",
      "description": "At least one test file must be produced",
      "type": "output_count",
      "min": 1,
      "severity": "error"
    },
    {
      "id": "no-skipped-tests",
      "description": "No tests marked as .skip or xit in output",
      "type": "file_not_contains",
      "banned_string": ".skip(",
      "severity": "error"
    },
    {
      "id": "no-todo-tests",
      "description": "No test stubs with TODO or placeholder body",
      "type": "file_not_contains",
      "banned_string": "// TODO",
      "severity": "warn"
    },
    {
      "id": "regression-coverage",
      "description": "Test file must include regression or edge case tests",
      "type": "file_contains",
      "required_string": "test(",
      "severity": "error"
    },
    {
      "id": "no-hardcoded-secrets",
      "description": "No hardcoded passwords, tokens, or API keys in test files",
      "type": "file_not_contains",
      "banned_string": "password123",
      "severity": "error"
    },
    {
      "id": "negative-tests-present",
      "description": "Tests must cover at least one failure/invalid-input scenario",
      "type": "file_contains",
      "required_string": "throw",
      "severity": "warn"
    }
  ],

  "anti_patterns": [
    {
      "id": "ice-cream-cone",
      "description": "More E2E tests than unit tests — inverted pyramid"
    },
    {
      "id": "testing-implementation-details",
      "description": "Tests that break on refactor without behavior change"
    },
    {
      "id": "flaky-test-tolerance",
      "description": "Any test marked as retry or flagged as flaky without fix"
    },
    {
      "id": "happy-path-only",
      "description": "No negative tests or edge case coverage"
    }
  ],

  "escalation_triggers": [
    "Bug affects user data integrity (data loss, corruption, wrong calculations)",
    "Same bug recurs after being marked fixed (twice)",
    "Test environment consistently differs from production",
    "Feature ships without meeting exit criteria"
  ],

  "handoff": {
    "input_requirements": [
      {
        "type": "file_exists",
        "pattern": "Spec.md",
        "description": "Spec.md exists and defines acceptance criteria",
        "sealed": false
      },
      {
        "type": "artifact_exists",
        "pattern": "Plan.json",
        "description": "Plan.json with implementation tasks",
        "sealed": false
      }
    ],
    "output_certifications": [
      "QA.md test strategy document exists",
      "All P0 and P1 test cases pass",
      "No open Blocker or Critical bugs",
      "Regression suite runs green",
      "At least one negative test per feature"
    ]
  }
}
